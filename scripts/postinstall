#!/bin/bash
PLIST=/Library/LaunchDaemons/com.ashahin.macostether.plist
chown root:wheel "$PLIST"
chmod 644 "$PLIST"
launchctl bootstrap system "$PLIST"
CONSOLE_USER=$(stat -f '%Su' /dev/console)
if [[ "$CONSOLE_USER" != root && "$CONSOLE_USER" != loginwindow && -n "$CONSOLE_USER" ]]; then
    launchctl asuser "$(id -u "$CONSOLE_USER")" /usr/bin/su - "$CONSOLE_USER" \
        -c '/usr/bin/open "/Applications/USB Tether.app"' >/dev/null 2>&1 || true
fi
exit 0
